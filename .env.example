# ============================================================
# AsA environment configuration  (copy to .env and edit)
# Nothing here is secret unless marked. Secrets live ONLY here
# (server-side). Never commit .env. No secret reaches the browser.
# ============================================================

# --- TTT market data -------------------------------------------------------
# Base URL of the True Trade v2 API. Public market-data endpoints need NO key.
TTT_API_BASE=https://apiv2.thetruetrade.io
# Optional read-only key for authenticated *read* routes.
# WARNING: TTT has no read-only futures key; the trade-futures scope unlocks
# order placement. AsA never implements order/position calls and its engine
# ignores any key for market data. Leave empty unless you understand this.
# MEASURED 2026-09-06: the venue edge answers 403 to ANY request carrying an
# X-API-Key header, including public routes that return 200 unsigned. AsA
# therefore NEVER signs market-data requests; setting these does not enable
# extra data. Run `npm run probe:caps` to reproduce.
TTT_API_KEY=
TTT_API_SECRET=
# Requests per minute budget shared by all TTT polling (per key & per IP).
# Observed practical ceiling from this network ~30/min; 429 -> scheduler pauses.
TTT_RATE_PER_MIN=24

# --- AI --------------------------------------------------------------------
# Local-first. Set one of the two, or leave empty for the deterministic
# HEURISTIC provider (labeled as such; never masquerades as an LLM).
OLLAMA_URL=
# OpenAI-compatible endpoint + key (server-side only, never proxied to browser)
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Model must exist in the provider catalogue or health reports DEGRADED.
AI_OPENAI_MODEL=gpt-4o-mini
# auto = probe local then cloud; heuristic = deterministic assembler only
AI_DEFAULT_PROVIDER=auto

# --- Fundamental / news ------------------------------------------------------
# Optional generic RSS connector. When unset the module reports NOT_CONFIGURED.
NEWS_RSS_URL=
NEWS_POLL_MIN=30

# --- Telegram ----------------------------------------------------------------
# Optional advisory outbox delivery. Empty = NOT_CONFIGURED (no sends, dry-run
# rows only). Advisory text only; never execution buttons.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 = configured but never sends (outbox rows stay QUEUED and are delivered
# later if you switch to 0). Verified 2026-09-06: flipping to 0 drained the
# backlog and Telegram accepted every row. Default 1 = safe.
TELEGRAM_DRY_RUN=1

# --- Storage -----------------------------------------------------------------
# SQLite is the local default. Path is relative to the repo root.
ASA_DB_PATH=./asa-data/asa.db
# Future Postgres adapter behind the same repository seam (see docs):
# DATABASE_URL=postgresql://user:pass@host:5432/asa

# --- Security ----------------------------------------------------------------
# Optional bearer token for mutating API routes (config writes, journal,
# analyze). Empty on localhost = open (documented); set on shared machines/VPS.
ASA_API_TOKEN=

# --- Risk defaults (deterministic risk engine, human-executed) ---------------
ASA_RISK_ACCOUNT_EQUITY=10000
ASA_RISK_PER_TRADE_PCT=1
ASA_RISK_MAX_LEVERAGE=5

# --- Observability -----------------------------------------------------------
ASA_PUBLIC_URL=http://localhost:3000
ASA_LOG_LEVEL=info
